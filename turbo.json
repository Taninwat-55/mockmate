{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**"],
      "env": [
        "DATABASE_URL",
        "NEXTAUTH_SECRET",
        "NEXTAUTH_URL",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "GOOGLE_GENERATIVE_AI_API_KEY",
        "CRON_SECRET",
        "POSTHOG_KEY",
        "RESEND_API_KEY",
        "AWS_LAMBDA_FUNCTION_NAME"
      ]
    },
    "dev": { "cache": false, "persistent": true },
    "lint": {}
  }
}
