// MockMate — Prisma Schema
// Phase 3 Design Artifact
//
// This file lives in docs/ until Phase 4 when the Next.js app is scaffolded.
// Final location: apps/web/prisma/schema.prisma
//
// IMPORTANT: The interview session model is named InterviewSession, not Session.
// NextAuth's Prisma adapter requires a model called Session for auth cookies.
// Using the same name for both would create a conflict — InterviewSession avoids it.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// NEXTAUTH MODELS
// Required by @auth/prisma-adapter. Do not rename these models.
// ============================================================

model User {
  id                 String             @id @default(cuid())
  name               String?
  email              String             @unique
  emailVerified      DateTime?
  image              String?
  savedResume        String?            @db.Text // last uploaded CV, plain text — pre-fills new sessions (#29)
  creditBalance      Int                @default(0)   // pay-per-use credits; 1 credit = 1 Pro interview (#16)
  freeSessionRefreshAt DateTime         @default(now()) // free tier: 1 session / 7 days; set to now()+7d when a free session starts (#16)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  // NextAuth relations
  accounts Account[]
  sessions Session[]

  // App relations
  interviewSessions InterviewSession[]
  creditPurchases   CreditPurchase[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// NextAuth session (auth cookie storage) — not the same as InterviewSession
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================
// ENUMS
// ============================================================

enum InterviewSessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum QuestionStatus {
  RESOLVED
  UNRESOLVED
}

enum MessageRole {
  AI
  USER
}

enum MessageType {
  MAIN_QUESTION
  USER_ANSWER
  FOLLOWUP_QUESTION
  FOLLOWUP_ANSWER
}

enum OverallSignal {
  HIRE
  NO_HIRE
  STRONG_HIRE
}

// ============================================================
// APP MODELS
// ============================================================

model InterviewSession {
  id                String                 @id @default(cuid())
  userId            String
  status            InterviewSessionStatus @default(IN_PROGRESS)
  title             String                 // User-provided label, e.g. "Frontend Engineer at Spotify"
  jobDescription    String                 @db.Text
  resume            String                 @db.Text
  mainQuestionCount Int                    @default(0)
  isPaid            Boolean                @default(false) // true = paid (credit) session → Pro models, email report, no history cap (#16)
  createdAt         DateTime               @default(now())
  lastActiveAt      DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  // Relations
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions Question[]
  feedback  Feedback?

  // Indexes for common queries
  @@index([userId])                        // list sessions per user
  @@index([status, lastActiveAt])          // cleanup cron: find IN_PROGRESS older than 24h
}

model Question {
  id                 String         @id @default(cuid())
  interviewSessionId String
  questionNumber     Int            // 1–5
  questionText       String         @db.Text
  followupCount      Int            @default(0) // max 2
  status             QuestionStatus @default(RESOLVED)
  evaluationNote     String?        @db.Text    // AI's hidden assessment, used for grading
  createdAt          DateTime       @default(now())

  // Relations
  interviewSession InterviewSession @relation(fields: [interviewSessionId], references: [id], onDelete: Cascade)
  messages         Message[]

  @@index([interviewSessionId])
}

model Message {
  id         String      @id @default(cuid())
  questionId String
  role       MessageRole
  type       MessageType
  content    String      @db.Text
  createdAt  DateTime    @default(now())

  // Relation
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model Feedback {
  id                 String @id @default(cuid())
  interviewSessionId String @unique // one feedback per session

  // Technical Accuracy dimension
  technicalAccuracyScore    Int
  technicalAccuracyStrength String @db.Text
  technicalAccuracyWeakness String @db.Text
  technicalAccuracyTip      String @db.Text

  // Communication Clarity dimension
  communicationClarityScore    Int
  communicationClarityStrength String @db.Text
  communicationClarityWeakness String @db.Text
  communicationClarityTip      String @db.Text

  // Problem-solving Approach dimension
  problemSolvingScore    Int
  problemSolvingStrength String @db.Text
  problemSolvingWeakness String @db.Text
  problemSolvingTip      String @db.Text

  // Overall result
  overallSignal  OverallSignal
  overallSummary String        @db.Text
  userRating     Int?          // 1–5, filled when user rates feedback on the feedback page

  createdAt DateTime @default(now())

  // Relation
  interviewSession InterviewSession @relation(fields: [interviewSessionId], references: [id], onDelete: Cascade)
}

// ============================================================
// BILLING (#16) — pay-per-use credits, one-time Stripe payments
// ============================================================

model CreditPurchase {
  id               String   @id @default(cuid())
  userId           String
  stripeSessionId  String   @unique // Stripe Checkout session id — idempotency guard against duplicate webhook delivery
  creditsPurchased Int
  amountPaid       Int      // smallest currency unit (1900 = 19.00 DKK)
  currency         String   @default("dkk")
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
